---
import "../styles/global.css";
import { pfad } from "../lib/labels";

interface Props {
  titel: string;
  beschreibung?: string;
  breit?: boolean;
  bild?: string;
  seitentyp?: "website" | "article";
}
const {
  titel,
  beschreibung = "Falschbehauptungen prüfen lernen – faktenbasiert, transparent, je nach Vorwissen aufbereitet.",
  breit = false,
  bild = "/og-default.png",
  seitentyp = "website",
} = Astro.props;

// Absolute URLs für Social-Media-Karten (brauchen vollständige https-Adressen).
const ogBild = new URL(pfad(bild), Astro.site).href;
const seiteUrl = new URL(Astro.url.pathname, Astro.site).href;

const nav = [
  { href: "/faktenchecks", text: "Faktenchecks" },
  { href: "/maschen", text: "Maschen" },
  { href: "/werkzeugkasten", text: "Werkzeugkasten" },
  { href: "/methodik", text: "Methodik" },
  { href: "/mitmachen", text: "Mitmachen", cta: true },
];
const aktuell = Astro.url.pathname.replace(/\/$/, "");
const vollerTitel = titel === "Kompetenzzentrum" ? titel : `${titel} · Kompetenzzentrum`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Theme früh setzen (vor dem Paint), damit kein Hell-Aufblitzen entsteht. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("kompetenz-theme");
          if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    <title>{vollerTitel}</title>
    <meta name="description" content={beschreibung} />
    <link rel="canonical" href={seiteUrl} />
    <meta property="og:title" content={vollerTitel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:type" content={seitentyp} />
    <meta property="og:url" content={seiteUrl} />
    <meta property="og:site_name" content="Kompetenzzentrum" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:image" content={ogBild} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kompetenzzentrum – Falschbehauptungen prüfen lernen" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={vollerTitel} />
    <meta name="twitter:description" content={beschreibung} />
    <meta name="twitter:image" content={ogBild} />
    <meta name="theme-color" content="#1c5fc4" />
    <link rel="icon" type="image/svg+xml" href={pfad("/favicon.svg")} />
    <link rel="sitemap" href={pfad("/sitemap-index.xml")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Zum Inhalt springen</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={pfad("/")}>
          <svg class="brand__mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="#1c5fc4" />
            <path d="M9 16.5l4.5 4.5L23 11" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>Kompetenzzentrum</span>
        </a>
        <nav class="site-nav site-nav--desktop" aria-label="Hauptnavigation">
          {nav.map((n) => (
            <a href={pfad(n.href)} class={n.cta ? "nav-cta" : undefined} aria-current={aktuell === pfad(n.href).replace(/\/$/, "") ? "page" : undefined}>{n.text}</a>
          ))}
        </nav>
        <div class="header-actions">
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Hell/Dunkel umschalten" title="Hell/Dunkel umschalten">
          <svg class="ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <svg class="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        </button>
        <details class="nav-burger">
          <summary aria-label="Menü öffnen">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
            </svg>
            <span class="nav-burger__text">Menü</span>
          </summary>
          <nav class="site-nav site-nav--mobile" aria-label="Hauptnavigation">
            {nav.map((n) => (
              <a href={pfad(n.href)} class={n.cta ? "nav-cta" : undefined} aria-current={aktuell === pfad(n.href).replace(/\/$/, "") ? "page" : undefined}>{n.text}</a>
            ))}
          </nav>
        </details>
        </div>
      </div>
    </header>

    <script>
      // Manueller Hell/Dunkel-Umschalter. Setzt data-theme auf <html> und merkt
      // sich die Wahl. Ohne Wahl folgt die Seite weiter dem Betriebssystem.
      const btn = document.getElementById("theme-toggle");
      if (btn) {
        const aktiv = () =>
          document.documentElement.dataset.theme ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const beschriften = () => {
          const dunkel = aktiv() === "dark";
          btn.setAttribute("aria-label", dunkel ? "Zu hellem Design wechseln" : "Zu dunklem Design wechseln");
          btn.setAttribute("title", dunkel ? "Zu hellem Design wechseln" : "Zu dunklem Design wechseln");
        };
        beschriften();
        btn.addEventListener("click", () => {
          const naechste = aktiv() === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = naechste;
          try { localStorage.setItem("kompetenz-theme", naechste); } catch (e) {}
          beschriften();
        });
      }
    </script>

    <main id="main" class={breit ? "container-wide" : "container"} style="padding-top: 2rem;">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container-wide">
        <div class="footer-grid">
          <div>
            <h4>Kompetenzzentrum</h4>
            <p class="muted" style="margin:.2rem 0 0;">Falschbehauptungen prüfen lernen. Offen, faktenbasiert, gemeinschaftlich gepflegt.</p>
          </div>
          <div>
            <h4>Inhalte</h4>
            <ul>
              <li><a href={pfad("/faktenchecks")}>Faktenchecks</a></li>
              <li><a href={pfad("/maschen")}>Maschen</a></li>
              <li><a href={pfad("/werkzeugkasten")}>Werkzeugkasten</a></li>
              <li><a href={pfad("/methodik")}>Methodik</a></li>
            </ul>
          </div>
          <div>
            <h4>Projekt</h4>
            <ul>
              <li><a href={pfad("/mitmachen")}>Mitmachen</a></li>
              <li><a href="https://github.com/pseidler89-sudo/Kompetenzzentrum">Quellcode (GitHub)</a></li>
              <li><a href="https://github.com/pseidler89-sudo/Kompetenzzentrum/issues">Fehler melden</a></li>
            </ul>
          </div>
          <div>
            <h4>Hinweis</h4>
            <p class="muted" style="margin:.2rem 0 0;">Inhalte unter CC BY-SA 4.0. Jede Aussage ist mit Quellen belegt und öffentlich nachvollziehbar.</p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
