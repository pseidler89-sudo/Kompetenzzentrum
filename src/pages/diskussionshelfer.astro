---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import UrteilBadge from "../components/UrteilBadge.astro";
import { pfad } from "../lib/labels";

const eintraege = (await getCollection("faktenchecks")).sort((a, b) =>
  a.data.titel.localeCompare(b.data.titel, "de"),
);
---

<BaseLayout titel="Diskussionshilfe" beschreibung="Belastbare Kurzantworten mit Quelle – griffbereit für Gespräche und Diskussionen.">
  <h1>Diskussionshilfe</h1>
  <p class="lead">
    Schnell die richtigen Fakten zur Hand: Behauptung, belegte Kurzantwort und die
    wichtigste Quelle. Zum Nachlesen führt jeder Eintrag zum vollständigen Faktencheck.
  </p>

  <div class="hinweis-bar">
    <strong>Tipp für gute Gespräche:</strong> Bleib sachlich, frag nach der Quelle der
    Gegenseite und nenne deine eigene. Es geht nicht ums Gewinnen, sondern ums Nachvollziehen.
  </div>

  <input type="search" id="suche" class="suche" placeholder="Stichwort suchen (z.B. Bürgergeld, Kriminalität) …" aria-label="Faktenkarten durchsuchen" />

  <div class="karten">
    {eintraege.map((e) => {
      const primaer = e.data.quellen.find((q) => q.art === "primaer") ?? e.data.quellen[0];
      const text = `Behauptung: „${e.data.behauptung}" — Fakt: ${e.data.kurzantwort} (Quelle: ${primaer.herausgeber})`;
      return (
        <div class="karte" data-suchtext={`${e.data.titel} ${e.data.behauptung} ${e.data.kurzantwort}`.toLowerCase()}>
          <div class="card__meta"><UrteilBadge urteil={e.data.urteil} /></div>
          <p class="karte__behauptung">„{e.data.behauptung}“</p>
          <p class="karte__antwort">{e.data.kurzantwort}</p>
          <p class="muted karte__quelle">Quelle: {primaer.herausgeber}{primaer.datum ? `, ${primaer.datum}` : ""}</p>
          <div class="karte__aktionen">
            <a class="btn btn--ghost btn--klein" href={pfad(`/faktenchecks/${e.id}`)}>Voller Faktencheck</a>
            <button class="btn btn--ghost btn--klein" type="button" data-kopieren={text}>Kopieren</button>
          </div>
        </div>
      );
    })}
  </div>
  <p id="keine-treffer" class="muted center" hidden style="margin-top:2rem;">Kein Treffer. Versuch ein anderes Stichwort.</p>
</BaseLayout>

<style>
  .hinweis-bar { background: var(--c-accent-soft); border: 1px solid color-mix(in srgb, var(--c-accent) 25%, transparent); border-radius: var(--radius); padding: .9rem 1.1rem; margin: 1.5rem 0; }
  .suche { width: 100%; padding: .8rem 1rem; font-size: 1rem; font-family: inherit; border: 1px solid var(--c-border); border-radius: 8px; background: var(--c-surface); color: var(--c-text); margin-bottom: 1.5rem; }
  .karten { display: grid; gap: 1rem; }
  .karte { background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); padding: 1.1rem 1.25rem; box-shadow: var(--shadow); }
  .karte__behauptung { font-style: italic; color: var(--c-text-soft); margin: .6rem 0 .3rem; }
  .karte__antwort { font-weight: 600; margin: 0 0 .4rem; }
  .karte__quelle { font-size: .85rem; margin: 0 0 .8rem; }
  .karte__aktionen { display: flex; gap: .5rem; flex-wrap: wrap; }
  .btn--klein { padding: .4rem .8rem; font-size: .85rem; }
  .karte.versteckt { display: none; }
</style>

<script>
  function init() {
    const suche = document.getElementById("suche") as HTMLInputElement | null;
    const karten = document.querySelectorAll<HTMLElement>(".karte");
    const leer = document.getElementById("keine-treffer");
    suche?.addEventListener("input", () => {
      const q = suche.value.trim().toLowerCase();
      let n = 0;
      karten.forEach((k) => {
        const treffer = !q || (k.dataset.suchtext ?? "").includes(q);
        k.classList.toggle("versteckt", !treffer);
        if (treffer) n++;
      });
      if (leer) leer.hidden = n > 0;
    });
    document.querySelectorAll<HTMLButtonElement>("[data-kopieren]").forEach((b) => {
      b.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.kopieren!);
          const alt = b.textContent;
          b.textContent = "Kopiert ✓";
          setTimeout(() => (b.textContent = alt), 1500);
        } catch { /* Zwischenablage nicht verfügbar */ }
      });
    });
  }
  init();
  document.addEventListener("astro:page-load", init);
</script>
