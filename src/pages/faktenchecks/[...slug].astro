---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import StufenSchalter from "../../components/StufenSchalter.astro";
import UrteilBadge from "../../components/UrteilBadge.astro";
import Quellen from "../../components/Quellen.astro";
import Datenviz from "../../components/Datenviz.astro";
import { THEMA_LABEL, TECHNIK_LABEL, STATUS_LABEL, URTEIL_LABEL, datumFormat, pfad } from "../../lib/labels";
import { md } from "../../lib/markdown";

export async function getStaticPaths() {
  const eintraege = await getCollection("faktenchecks");
  return eintraege.map((e) => ({ params: { slug: e.id }, props: { eintrag: e } }));
}

const { eintrag } = Astro.props;
const { data } = eintrag;

// Die drei Tiefen, gerendert aus den Inhaltsfeldern.
const stufen = [
  { key: "einstieg", label: "Einstieg", html: md(data.einstieg) },
  { key: "vertiefung", label: "Vertiefung", html: md(data.vertiefung) },
  { key: "wissenschaftlich", label: "Wissenschaftlich", html: md(data.wissenschaftlich) },
];

const alle = await getCollection("faktenchecks");
const verwandt = (data.verwandt ?? [])
  .map((slug) => alle.find((e) => e.id === slug))
  .filter(Boolean);

// Teilbarer Kurztext: Fakt + wichtigste Quelle + Link. Für Gespräche & Social Media.
const primaer = data.quellen.find((q) => q.art === "primaer") ?? data.quellen[0];
const seiteUrl = new URL(pfad(`/faktenchecks/${eintrag.id}`), Astro.site).href;
const teilenText = `„${data.behauptung}“\n\nFakt: ${data.kurzantwort}\n\nQuelle: ${primaer.herausgeber}${primaer.datum ? `, ${primaer.datum}` : ""}\nMehr dazu: ${seiteUrl}`;

// ClaimReview-Strukturdaten (schema.org) – damit Suchmaschinen den Faktencheck
// als solchen erkennen und im Ergebnis hervorheben. ratingValue: 1 = falsch … 5 = wahr.
const URTEIL_RATING: Record<string, number> = {
  falsch: 1,
  "groesstenteils-falsch": 2,
  irrefuehrend: 2,
  "fehlender-kontext": 3,
  "teils-richtig": 3,
};
const orgUrl = new URL(pfad("/"), Astro.site).href;
const claimReview = {
  "@context": "https://schema.org",
  "@type": "ClaimReview",
  url: seiteUrl,
  datePublished: data.veroeffentlicht.toISOString().slice(0, 10),
  ...(data.aktualisiert ? { dateModified: data.aktualisiert.toISOString().slice(0, 10) } : {}),
  claimReviewed: data.behauptung,
  author: { "@type": "Organization", name: "Kompetenzzentrum", url: orgUrl },
  reviewRating: {
    "@type": "Rating",
    ratingValue: URTEIL_RATING[data.urteil] ?? 3,
    bestRating: 5,
    worstRating: 1,
    alternateName: URTEIL_LABEL[data.urteil] ?? data.urteil,
  },
  itemReviewed: {
    "@type": "Claim",
    name: data.behauptung,
    appearance: { "@type": "CreativeWork", url: seiteUrl },
  },
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(claimReview)} />

<BaseLayout titel={data.titel} beschreibung={data.zusammenfassung} seitentyp="article" bild={`/og/${eintrag.id}.png`}>
  <article>
    <a href={pfad("/faktenchecks")} class="muted" style="text-decoration:none;">← Alle Faktenchecks</a>

    <div class="card__meta" style="margin-top:1rem;">
      <UrteilBadge urteil={data.urteil} />
      {data.themen.map((t) => <span class="badge">{THEMA_LABEL[t] ?? t}</span>)}
      {data.status !== "geprueft" && <span class="badge" title="Redaktioneller Status">{STATUS_LABEL[data.status]}</span>}
    </div>

    <h1 style="margin-top:.75rem;">{data.titel}</h1>

    <div class="behauptung-box">
      <span class="behauptung-box__label">Die Behauptung</span>
      <p>„{data.behauptung}“</p>
    </div>

    <div class="kurzantwort-box">
      <span class="kurzantwort-box__label">Kurzantwort</span>
      <p class="lead" style="color:var(--c-text);margin:.25rem 0 0;">{data.kurzantwort}</p>
      <div class="teilen">
        <button type="button" class="btn btn--ghost btn--klein" data-teilen={teilenText}>
          📋 Kurzantwort kopieren
        </button>
        <span class="teilen__hint muted">Fakt + Quelle + Link – griffbereit für Gespräche und Social Media.</span>
      </div>
    </div>

    {data.techniken.length > 0 && (
      <div class="tag-list" style="margin:1.25rem 0;">
        <span class="muted" style="font-size:.85rem;align-self:center;">Erkannte Maschen:</span>
        {data.techniken.map((t) => (
          <a class="badge badge--technik" href={pfad(`/maschen/${t}`)}>{TECHNIK_LABEL[t] ?? t} →</a>
        ))}
      </div>
    )}

    {data.einleitung && (
      <div class="prose fc-einleitung" set:html={md(data.einleitung)} />
    )}

    <StufenSchalter />

    <div class="prose" data-faktencheck-body>
      {stufen.map((s) => (
        <div class={`stufe stufe-${s.key}`} data-stufe={s.key}>
          <p class="stufe-heading">{s.label}</p>
          <div set:html={s.html} />
        </div>
      ))}

      {data.technik_titel && (
        <aside class="box box-technik" data-technik={data.technik_titel}>
          <p class="box-label"><strong>Technik erkannt: {data.technik_titel}</strong></p>
          <div set:html={md(data.technik_text)} />
        </aside>
      )}

      {data.pruefen && (
        <aside class="box box-pruefen">
          <p class="box-label"><strong>So prüfst du das selbst</strong></p>
          <div set:html={md(data.pruefen)} />
        </aside>
      )}
    </div>

    {data.daten?.length > 0 && (
      <section class="fc-daten" aria-label="Die Zahlen im Überblick">
        <h2>Die Zahlen im Überblick</h2>
        <Datenviz daten={data.daten} />
      </section>
    )}

    <Quellen quellen={data.quellen} />

    {verwandt.length > 0 && (
      <section style="margin-top:2.5rem;">
        <h2>Verwandte Faktenchecks</h2>
        <div class="grid grid--2">
          {verwandt.map((e: any) => (
            <a class="card" href={pfad(`/faktenchecks/${e.id}`)}>
              <UrteilBadge urteil={e.data.urteil} />
              <h3>{e.data.titel}</h3>
            </a>
          ))}
        </div>
      </section>
    )}

    <footer class="fc-footer">
      <p class="muted">
        Veröffentlicht am {datumFormat(data.veroeffentlicht)}
        {data.aktualisiert && ` · aktualisiert am ${datumFormat(data.aktualisiert)}`}
        {data.mitwirkende.length > 0 && ` · Mitwirkende: ${data.mitwirkende.join(", ")}`}
      </p>
    </footer>
  </article>
</BaseLayout>

<style>
  .behauptung-box, .kurzantwort-box {
    margin: 1.5rem 0; padding: 1.1rem 1.3rem; border-radius: var(--radius);
    border: 1px solid var(--c-border); border-left-width: 4px;
  }
  .behauptung-box { background: var(--c-surface-2); border-left-color: var(--c-falsch); }
  .kurzantwort-box { background: var(--c-accent-soft); border-left-color: var(--c-accent); }
  .behauptung-box__label, .kurzantwort-box__label {
    font-size: .76rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em;
  }
  .behauptung-box__label { color: var(--c-falsch); }
  .kurzantwort-box__label { color: var(--c-accent); }
  .behauptung-box p { margin: .3rem 0 0; font-size: 1.15rem; font-style: italic; color: var(--c-text); }
  .kurzantwort-box .lead { font-size: 1.18rem; line-height: 1.5; }
  .teilen { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; margin-top: .9rem; }
  .btn--klein { padding: .4rem .8rem; font-size: .85rem; }
  .btn--erfolg { background: var(--c-accent); color: #fff; border-color: var(--c-accent); }
  .teilen__hint { font-size: .82rem; }
  .fc-footer { margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--c-border); font-size: .92rem; }
</style>

<script>
  function initTeilen() {
    document.querySelectorAll<HTMLButtonElement>("[data-teilen]").forEach((b) => {
      b.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.teilen!);
          const alt = b.textContent;
          b.textContent = "Kopiert ✓";
          b.classList.add("btn--erfolg");
          setTimeout(() => { b.textContent = alt; b.classList.remove("btn--erfolg"); }, 1800);
        } catch { /* Zwischenablage nicht verfügbar */ }
      });
    });
  }
  initTeilen();
  document.addEventListener("astro:page-load", initTeilen);
</script>
