---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { pfad, MASCHE_ICON } from "../../lib/labels";

const maschen = (await getCollection("maschen")).sort(
  (a, b) => a.data.reihenfolge - b.data.reihenfolge,
);

const flicc = maschen.filter((m) => m.data.kategorie === "flicc");
const rhetorik = maschen.filter((m) => m.data.kategorie === "rhetorik");

function karte(m: (typeof maschen)[number]) {
  return m;
}
---

<BaseLayout titel="Maschen erkennen" beschreibung="Die wiederkehrenden Manipulationstechniken hinter Desinformation – mit aktuellen Beispielen und konkreten Tipps, wie du sie durchschaust.">
  <header class="maschen-hero">
    <p class="eyebrow">So wirst du manipuliert – und so durchschaust du es</p>
    <h1>Maschen erkennen</h1>
    <p class="lead">
      Falschbehauptungen wechseln ständig das Thema – die <strong>Maschen dahinter</strong>
      bleiben fast immer dieselben. Wer sie einmal kennt, erkennt sie überall wieder:
      ob bei Migration, Klima oder Sozialpolitik. Das ist wie eine Impfung gegen
      Desinformation – Fachleute nennen es <em>Prebunking</em>.
    </p>
    <p class="muted hinweis-fair">
      Hier wird niemand bloßgestellt. Auf diese Maschen fällt jede:r mal herein –
      sie sind gemacht, um zu funktionieren. Genau deshalb lohnt es sich, sie zu kennen.
    </p>
    <p class="muted">
      Die Muster sind keine Meinung, sondern Stand der Forschung zu Desinformation.
      Die wissenschaftlichen Belege (u. a. <em>Debunking Handbook 2020</em>, FLICC-Modell)
      stehen offen unter <a href={pfad("/methodik/wissenschaftliche-grundlagen")}>Wissenschaftliche Grundlagen</a>.
    </p>
  </header>

  <aside class="quiz-banner">
    <div>
      <strong>Schon geübt?</strong> Teste im Quiz, ob du die Maschen an echten Beispielen erkennst.
    </div>
    <a class="btn btn--primary" href={pfad("/quiz")}>Quiz: Erkennst du die Masche? →</a>
  </aside>

  <div class="masche-suchzeile">
    <input type="search" id="masche-suche" class="masche-suche" placeholder="Masche suchen (z.B. Sündenbock, Cherry Picking, Angst) …" aria-label="Maschen durchsuchen" />
    <div class="masche-kat" role="group" aria-label="Nach Kategorie filtern">
      <button type="button" class="masche-kat-btn" data-kat="alle" aria-pressed="true">Alle</button>
      <button type="button" class="masche-kat-btn" data-kat="flicc" aria-pressed="false">Kerntechniken</button>
      <button type="button" class="masche-kat-btn" data-kat="rhetorik" aria-pressed="false">Weitere Muster</button>
    </div>
  </div>

  <section class="js-sektion" data-sektion="flicc">
    <h2>Die 5 Kerntechniken</h2>
    <p class="muted">
      Diese fünf Muster gelten in der Forschung als der Kern von Desinformation –
      von erfundenen Expert:innen bis zur Verschwörungserzählung. Fachleute fassen
      sie unter dem Kürzel <abbr title="Fake Experts, Logical Fallacies, Impossible Expectations, Cherry Picking, Conspiracy Theories – die fünf Kernmuster der Wissenschaftsleugnung">FLICC</abbr>
      zusammen (englisch für die fünf Anfangsbuchstaben). Den Namen muss man sich
      nicht merken – die Muster zu kennen, reicht völlig.
    </p>
    <div class="masche-grid">
      {flicc.map((m) => (
        <a class="masche-card masche-item" href={pfad(`/maschen/${m.id}`)} data-suchtext={`${m.data.titel} ${m.data.kurz} ${m.data.code}`.toLowerCase()}>
          <div class="masche-card__top">
            <span class="masche-ic" aria-hidden="true"><Icon name={MASCHE_ICON[m.data.code] ?? "lucide:shield-alert"} /></span>
            <span class="masche-card__tag">Kerntechnik</span>
          </div>
          <h3>{m.data.titel}</h3>
          <p>{m.data.kurz}</p>
          <span class="masche-card__more">Masche ansehen →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="js-sektion" data-sektion="rhetorik">
    <h2>Weitere häufige Muster</h2>
    <p class="muted">
      Rhetorische Tricks und Denkfehler, die in politischen Debatten besonders oft vorkommen.
    </p>
    <div class="masche-grid">
      {rhetorik.map((m) => (
        <a class="masche-card masche-card--rhetorik masche-item" href={pfad(`/maschen/${m.id}`)} data-suchtext={`${m.data.titel} ${m.data.kurz} ${m.data.code}`.toLowerCase()}>
          <div class="masche-card__top">
            <span class="masche-ic" aria-hidden="true"><Icon name={MASCHE_ICON[m.data.code] ?? "lucide:shield-alert"} /></span>
          </div>
          <h3>{m.data.titel}</h3>
          <p>{m.data.kurz}</p>
          <span class="masche-card__more">Masche ansehen →</span>
        </a>
      ))}
    </div>
  </section>

  <p id="masche-leer" class="muted center" hidden style="margin-top:2rem;">
    Keine Masche passt zu deiner Suche.
    <button type="button" id="masche-reset" class="linklike">Suche zurücksetzen</button>
  </p>

  <section class="maschen-cta">
    <h2>Lieber an konkreten Behauptungen lernen?</h2>
    <p class="muted">
      Beide Wege führen zum Ziel: Über die <a href={pfad("/faktenchecks")}>Faktenchecks</a>
      siehst du die Maschen an echten, geprüften Behauptungen – jede Masche zeigt dir
      umgekehrt, in welchen Faktenchecks sie steckt.
    </p>
    <a class="btn btn--ghost" href={pfad("/faktenchecks")}>Zu den Faktenchecks</a>
  </section>
</BaseLayout>

<style>
  .maschen-hero { max-width: 46rem; margin: 1rem 0 2.5rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: .06em; font-weight: 800; color: var(--c-technik); font-size: .8rem; margin: 0 0 .4rem; }
  .hinweis-fair { font-size: .95rem; border-left: 3px solid var(--c-technik); padding-left: .9rem; margin-top: 1.25rem; }
  section { margin-top: 3rem; }
  .masche-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: 1rem; margin-top: 1.25rem; }
  .masche-card {
    display: flex; flex-direction: column; gap: .5rem;
    background: var(--c-surface); border: 1px solid var(--c-border);
    border-top: 3px solid var(--c-technik);
    border-radius: var(--radius); padding: 1.1rem 1.2rem;
    text-decoration: none; color: inherit; box-shadow: var(--shadow);
    transition: transform .15s ease, border-color .15s ease;
  }
  .masche-card--rhetorik { border-top-color: var(--c-border-strong); }
  .masche-card:hover { transform: translateY(-2px); border-color: var(--c-technik); }
  .masche-card__top { display: flex; align-items: center; gap: .7rem; }
  .masche-ic {
    width: 2.3rem; height: 2.3rem; flex: none; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--c-technik) 12%, var(--c-surface));
    color: var(--c-technik);
  }
  .masche-card--rhetorik .masche-ic { background: var(--c-surface-2); color: var(--c-text-soft); }
  .masche-ic svg { width: 1.25rem; height: 1.25rem; }
  .masche-card__tag { font-size: .68rem; font-weight: 800; letter-spacing: .05em; color: var(--c-technik); text-transform: uppercase; }
  .masche-card h3 { margin: 0; font-size: 1.12rem; }
  .masche-card p { margin: 0; color: var(--c-text-soft); font-size: .92rem; line-height: 1.5; flex: 1; }
  .masche-card__more { font-size: .85rem; font-weight: 700; color: var(--c-technik); }
  .maschen-cta { padding: 1.75rem; background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); }
  .maschen-cta h2 { margin-top: 0; }

  .quiz-banner { display: flex; gap: 1rem; align-items: center; justify-content: space-between; flex-wrap: wrap; margin: 0 0 1.5rem; padding: 1rem 1.25rem; background: color-mix(in srgb, var(--c-technik) 8%, var(--c-surface)); border: 1px solid var(--c-border); border-radius: var(--radius); }
  .quiz-banner .btn { flex: none; }
  .masche-suchzeile { display: flex; gap: .75rem; align-items: center; margin: 0 0 1rem; flex-wrap: wrap; }
  .masche-suche { flex: 1; min-width: 14rem; padding: .8rem 1rem; font-size: 1rem; font-family: inherit; border: 1px solid var(--c-border); border-radius: var(--radius-sm); background: var(--c-surface); color: var(--c-text); }
  .masche-kat { display: flex; gap: .5rem; flex-wrap: wrap; }
  .masche-kat-btn { font-family: inherit; font-weight: 600; font-size: .88rem; padding: .4rem .85rem; border-radius: 999px; cursor: pointer; border: 1px solid var(--c-border); background: var(--c-surface); color: var(--c-text-soft); }
  .masche-kat-btn:hover { border-color: var(--c-technik); }
  .masche-kat-btn[aria-pressed="true"] { background: var(--c-technik); border-color: var(--c-technik); color: #fff; }
  .masche-item.versteckt { display: none; }
  .js-sektion[hidden] { display: none; }
  .linklike { background: none; border: none; color: var(--c-link); cursor: pointer; font: inherit; text-decoration: underline; padding: 0; }
</style>

<script>
  function init() {
    const suche = document.getElementById("masche-suche") as HTMLInputElement | null;
    const katBtns = document.querySelectorAll<HTMLButtonElement>(".masche-kat-btn");
    const items = document.querySelectorAll<HTMLElement>(".masche-item");
    const sektionen = document.querySelectorAll<HTMLElement>(".js-sektion");
    const leer = document.getElementById("masche-leer");
    const reset = document.getElementById("masche-reset");
    if (!suche) return;

    let kat = "alle";

    function anwenden() {
      const q = (suche?.value ?? "").trim().toLowerCase();
      let sichtbar = 0;
      items.forEach((it) => {
        const passt = (!q || (it.dataset.suchtext ?? "").includes(q));
        it.classList.toggle("versteckt", !passt);
        if (passt) sichtbar++;
      });
      // Eine Sektion ausblenden, wenn die Kategorie sie ausschließt oder kein
      // Treffer darin sichtbar ist (sonst stünde eine Überschrift ohne Karten da).
      sektionen.forEach((sek) => {
        const passtKat = kat === "alle" || sek.dataset.sektion === kat;
        const hatTreffer = Array.from(sek.querySelectorAll<HTMLElement>(".masche-item"))
          .some((it) => !it.classList.contains("versteckt"));
        sek.hidden = !(passtKat && hatTreffer);
      });
      if (leer) leer.hidden = !sektionen.length || Array.from(sektionen).some((s) => !s.hidden);
    }

    katBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        kat = btn.dataset.kat ?? "alle";
        katBtns.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        anwenden();
      });
    });
    suche.addEventListener("input", anwenden);
    reset?.addEventListener("click", () => {
      suche.value = "";
      kat = "alle";
      katBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.kat === "alle")));
      anwenden();
    });

    anwenden();
  }
  init();
  document.addEventListener("astro:page-load", init);
</script>
