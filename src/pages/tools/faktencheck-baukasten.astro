---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { THEMEN, URTEILE, TECHNIKEN } from "../../content.config";
import { THEMA_LABEL, URTEIL_LABEL, TECHNIK_LABEL, TECHNIK_ERKLAERUNG, pfad } from "../../lib/labels";

// Reihenfolge der Themen wie im Katalog wäre schön, hier reicht die Schema-Reihenfolge.
const repo = "pseidler89-sudo/Kompetenzzentrum";
---

<BaseLayout titel="Faktencheck-Baukasten" beschreibung="Faktencheck im Formular zusammenstellen – mit echter Live-Vorschau – und direkt als Pull Request auf GitHub anlegen." breit>
  <div class="fcb-head">
    <p class="eyebrow">Werkzeug für Mitwirkende</p>
    <h1>Faktencheck-Baukasten</h1>
    <p class="lead">
      Links eintragen, rechts <strong>live sehen, wie es auf der Seite aussieht</strong>.
      Am Ende „Auf GitHub anlegen“ – dein Beitrag wird automatisch ein Pull Request,
      den die Redaktion prüft. Kein Markdown, kein <code>npm</code>, keine Technik nötig.
    </p>
  </div>

  <div class="fcb">
    <!-- ============ EINGABE ============ -->
    <form class="fcb-form" id="fcb-form" autocomplete="off">
      <p class="fcb-step">1 · Die Behauptung</p>
      <label class="fcb-field">
        <span>Behauptung (möglichst im Wortlaut)</span>
        <textarea id="f-behauptung" rows="2" placeholder="z. B. „Das Bürgergeld lohnt sich mehr als Arbeit.“"></textarea>
      </label>
      <label class="fcb-field">
        <span>Titel (kurz, oft die Behauptung in Anführungszeichen)</span>
        <input id="f-titel" type="text" placeholder="„Arbeit lohnt sich nicht mehr“" />
      </label>

      <p class="fcb-step">2 · Das Urteil & die Kurzantwort</p>
      <label class="fcb-field">
        <span>Urteil</span>
        <select id="f-urteil">
          {URTEILE.map((u) => <option value={u}>{URTEIL_LABEL[u]}</option>)}
        </select>
      </label>
      <label class="fcb-field">
        <span>Kurzantwort (Fakt zuerst – 1–2 Sätze, steht ganz oben)</span>
        <textarea id="f-kurzantwort" rows="3" placeholder="Der belegte Fakt in einem Satz …"></textarea>
      </label>
      <label class="fcb-field">
        <span>Kurzbeschreibung (für Vorschau & Suchmaschinen, max. 300 Zeichen)</span>
        <textarea id="f-zus" rows="2" maxlength="300"></textarea>
      </label>

      <p class="fcb-step">3 · Einordnung</p>
      <div class="fcb-field">
        <span>Themen</span>
        <div class="fcb-checks">
          {THEMEN.map((t) => (
            <label class="fcb-check"><input type="checkbox" name="thema" value={t} />{THEMA_LABEL[t]}</label>
          ))}
        </div>
      </div>
      <div class="fcb-field">
        <span>Erkannte Maschen (optional) – ⓘ antippen für die Erklärung</span>
        <div class="fcb-maschen">
          {TECHNIKEN.map((t) => (
            <div class="fcb-masche">
              <label class="fcb-check"><input type="checkbox" name="technik" value={t} /><span class="fcb-masche-name">{TECHNIK_LABEL[t]}</span></label>
              <button type="button" class="fcb-info" data-info aria-expanded="false" aria-label={`Erklärung: ${TECHNIK_LABEL[t]}`}>ⓘ</button>
              <p class="fcb-masche-desc" hidden>{TECHNIK_ERKLAERUNG[t]}</p>
            </div>
          ))}
        </div>
      </div>

      <p class="fcb-step">4 · Der Inhalt (drei Tiefen)</p>
      <label class="fcb-field">
        <span>Einleitung (Fakt zuerst – beginnt mit dem belegten Stand)</span>
        <textarea id="f-einleitung" rows="2"></textarea>
      </label>
      <label class="fcb-field">
        <span>① Einstieg – kompakt, ohne Vorwissen</span>
        <textarea id="f-einstieg" rows="4"></textarea>
      </label>
      <label class="fcb-field">
        <span>② Vertiefung – Zahlen & Kontext</span>
        <textarea id="f-vertiefung" rows="4"></textarea>
      </label>
      <label class="fcb-field">
        <span>③ Wissenschaftlich – Quellen & Methodik</span>
        <textarea id="f-wiss" rows="4"></textarea>
      </label>

      <p class="fcb-step">5 · Trick-Box & Selbst-Prüfen (optional)</p>
      <p class="fcb-help muted">Die <strong>Maschen oben</strong> verlinken zur allgemeinen Erklärung. Diese Box ist etwas anderes: Hier sagst du optional in 1–2 Sätzen, <em>wie</em> der Trick in <em>genau dieser</em> Behauptung steckt. Kann auch leer bleiben.</p>
      <label class="fcb-field">
        <span>Überschrift der Trick-Box</span>
        <input id="f-technik-titel" type="text" placeholder="z. B. „Fehlender Bezugswert & Cherry Picking“" />
        <button type="button" id="f-technik-auto" class="fcb-mini">Aus markierten Maschen übernehmen</button>
      </label>
      <label class="fcb-field">
        <span>Wie die Masche hier wirkt</span>
        <textarea id="f-technik-text" rows="3"></textarea>
      </label>
      <label class="fcb-field">
        <span>So prüfst du das selbst (gern als Liste mit „- “)</span>
        <textarea id="f-pruefen" rows="3"></textarea>
      </label>

      <p class="fcb-step">6 · Quellen (Pflicht – Primärquellen bevorzugen)</p>
      <div id="f-quellen" class="fcb-quellen"></div>
      <button type="button" id="f-quelle-add" class="fcb-add">+ Quelle hinzufügen</button>

      <p class="fcb-step">7 · Datengrafik (optional)</p>
      <p class="fcb-help muted">Nur, wo eine Zahl/Beziehung etwas trägt – nie Deko, immer mit Quelle. Erscheint rechts live und im Block „Die Zahlen im Überblick". Meist reicht „Vergleich" oder „Kennzahl".</p>
      <div id="f-charts" class="fcb-charts"></div>
      <button type="button" id="f-chart-add" class="fcb-add">+ Grafik hinzufügen</button>
      <p class="fcb-hint muted">Lieber separat/visuell? Der eigenständige <a href={pfad("/tools/grafik.html")}>Grafik-Baukasten</a> bleibt verfügbar.</p>
    </form>

    <!-- ============ LIVE-VORSCHAU ============ -->
    <div class="fcb-preview-col">
      <p class="fcb-step">Live-Vorschau</p>
      <article class="fcb-preview" id="fcb-preview"></article>

      <div class="fcb-out">
        <p class="fcb-step">Fertig? Absenden – der Rest passiert automatisch</p>
        <div class="fcb-actions">
          <button type="button" id="f-submit" class="btn btn--primary">Faktencheck absenden →</button>
          <button type="button" id="f-copy" class="btn btn--ghost">Nur Text kopieren</button>
        </div>
        <p id="f-status" class="fcb-status" hidden></p>
        <p class="muted" style="font-size:.85rem;margin:.6rem 0 0;">
          Beim ersten Mal meldest du dich kurz an (GitHub – Login auch per Google möglich).
          Danach wird dein Faktencheck automatisch als Vorschlag eingereicht – die Redaktion
          liest gegen und gibt ihn frei. Du musst nichts mit Technik oder Dateien machen.
        </p>
        <p class="muted fcb-fallback" id="f-fallback-wrap" hidden style="font-size:.85rem;margin:.5rem 0 0;">
          Klappt das Anmelden nicht? <a id="f-github" href="#" target="_blank" rel="noopener">Manuell über GitHub anlegen</a>.
        </p>
        <details class="fcb-raw">
          <summary>Text ansehen (für Neugierige)</summary>
          <pre id="f-raw"></pre>
        </details>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .fcb-head { max-width: 46rem; margin-bottom: 1.5rem; }
  .eyebrow { text-transform: uppercase; letter-spacing: .06em; font-weight: 800; color: var(--c-accent); font-size: .8rem; margin: 0 0 .3rem; }
  .fcb { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem; align-items: start; }
  @media (max-width: 900px) { .fcb { grid-template-columns: 1fr; } }

  .fcb-step { font-size: .76rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--c-accent); margin: 1.6rem 0 .6rem; }
  .fcb-form .fcb-step:first-child { margin-top: 0; }
  .fcb-field { display: block; margin-bottom: .9rem; }
  .fcb-field > span { display: block; font-size: .85rem; font-weight: 600; color: var(--c-text-soft); margin-bottom: .3rem; }
  .fcb-form input[type=text], .fcb-form textarea, .fcb-form select {
    width: 100%; font: inherit; font-size: .95rem; padding: .55rem .7rem; color: var(--c-text);
    background: var(--c-surface); border: 1px solid var(--c-border-strong); border-radius: 8px;
  }
  .fcb-form textarea { resize: vertical; line-height: 1.5; }
  .fcb-form :focus-visible { outline: 2px solid var(--c-accent); outline-offset: 1px; border-color: var(--c-accent); }
  .fcb-checks { display: flex; flex-wrap: wrap; gap: .4rem .9rem; }
  .fcb-check { display: inline-flex; align-items: center; gap: .35rem; font-size: .9rem; font-weight: 500; }
  .fcb-check input { width: auto; }

  /* Maschen-Auswahl mit ⓘ-Erklärung */
  .fcb-maschen { display: grid; gap: .15rem; }
  .fcb-masche { display: grid; grid-template-columns: 1fr auto; align-items: center; column-gap: .5rem; padding: .15rem 0; border-bottom: 1px solid var(--c-border); }
  .fcb-masche .fcb-check { font-weight: 600; }
  .fcb-info { font: inherit; font-size: 1.05rem; line-height: 1; cursor: pointer; background: none; border: none; color: var(--c-accent); padding: .15rem .35rem; border-radius: 6px; }
  .fcb-info:hover, .fcb-info[aria-expanded="true"] { background: var(--c-accent-soft); }
  .fcb-masche-desc { grid-column: 1 / -1; margin: .1rem 0 .4rem; font-size: .85rem; color: var(--c-text-soft); line-height: 1.45; }
  .fcb-help { font-size: .85rem; margin: -.2rem 0 .6rem; }
  .fcb-mini { margin-top: .35rem; font: inherit; font-size: .78rem; font-weight: 700; color: var(--c-accent); background: none; border: none; padding: 0; cursor: pointer; text-decoration: underline; }

  .fcb-quellen { display: flex; flex-direction: column; gap: .6rem; }
  .fcb-quelle .q-f { display: block; }
  .fcb-quelle .q-f > span { display: block; font-size: .76rem; font-weight: 600; color: var(--c-text-soft); margin-bottom: .2rem; }
  .fcb-quelle .q-bottom { align-items: end; }

  /* Chart-Builder (Datengrafiken im Faktencheck-Baukasten) */
  .fcb-charts { display: flex; flex-direction: column; gap: .7rem; }
  .fcb-chart { border: 1px solid var(--c-border); border-radius: 9px; padding: .8rem; background: var(--c-surface); display: grid; gap: .5rem; }
  .fcb-chart .c-row { display: grid; grid-template-columns: 1fr 1fr; gap: .4rem; }
  @media (max-width: 560px) { .fcb-chart .c-row { grid-template-columns: 1fr; } }
  .fcb-chart .c-werte { display: flex; flex-direction: column; gap: .35rem; }
  .fcb-chart .c-wert { display: grid; grid-template-columns: 1fr 5rem 4rem auto; gap: .3rem; align-items: center; }
  @media (max-width: 560px) { .fcb-chart .c-wert { grid-template-columns: 1fr 1fr; } }
  .fcb-chart .c-wert .c-del { font: inherit; font-size: .75rem; color: var(--c-falsch); background: none; border: none; cursor: pointer; padding: 0; }
  .fcb-chart .c-werte-add { font: inherit; font-size: .8rem; font-weight: 700; color: var(--c-accent); background: none; border: none; cursor: pointer; padding: 0; justify-self: start; }
  .fcb-chart .del { justify-self: start; font: inherit; font-size: .8rem; color: var(--c-falsch); background: none; border: none; cursor: pointer; padding: 0; }
  .fcb-chart .c-check { display: inline-flex; align-items: center; gap: .35rem; font-size: .85rem; }
  .fcb-chart .c-check input { width: auto; }

  /* Datenviz-Vorschau (gespiegelt aus Datenviz.astro) */
  .fcb-preview .dv { margin: 0; padding: 1.25rem 1.4rem; background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); box-shadow: var(--shadow); }
  .fcb-preview .dv__title { font-size: .98rem; color: var(--c-text-soft); margin: 0 0 1rem; }
  .fcb-preview .dv__title strong { color: var(--c-text); font-weight: 700; }
  .fcb-preview .dv__hint { font-size: .85rem; color: var(--c-text-soft); font-style: italic; margin: -.5rem 0 1rem; }
  .fcb-preview .dv__source { display: flex; align-items: center; gap: .4rem; margin-top: 1rem; padding-top: .75rem; border-top: 1px solid var(--c-border); font-size: .75rem; color: var(--c-text-soft); }
  .fcb-preview .dv__bars { display:flex; flex-direction:column; gap:14px; }
  .fcb-preview .dv__rw { display:grid; grid-template-columns:180px 1fr auto; gap:14px; align-items:center; }
  .fcb-preview .dv__lab { font-size:.9rem; font-weight:600; } .fcb-preview .dv__lab small { display:block; font-weight:500; color:var(--c-text-soft); font-size:.78rem; }
  .fcb-preview .dv__track { position:relative; height:30px; background:var(--c-surface-2); border-radius:6px; overflow:hidden; }
  .fcb-preview .dv__fill { height:100%; border-radius:6px; min-width:4px; }
  .fcb-preview .dv__val { font-weight:800; font-size:.9rem; font-variant-numeric:tabular-nums; min-width:3.4rem; text-align:right; }
  .fcb-preview .dv__stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(11rem,1fr)); gap:14px; }
  .fcb-preview .dv__stat { border:1px solid var(--c-border); border-left:4px solid var(--c-accent); border-radius:var(--radius-sm); padding:14px 16px; }
  .fcb-preview .dv__num { font-size:2rem; font-weight:800; letter-spacing:-.02em; line-height:1; }
  .fcb-preview .dv__cap { margin-top:6px; font-size:.88rem; color:var(--c-text-soft); }
  .fcb-preview .dv__stack { display:flex; height:42px; border-radius:8px; overflow:hidden; border:1px solid var(--c-border); }
  .fcb-preview .dv__seg { display:flex; align-items:center; justify-content:center; color:#fff; font-weight:700; font-size:.78rem; overflow:hidden; white-space:nowrap; }
  .fcb-preview .dv__seg span { padding:0 .4rem; overflow:hidden; text-overflow:ellipsis; }
  .fcb-preview .dv__legend { display:flex; flex-wrap:wrap; gap:14px; margin-top:12px; font-size:.82rem; color:var(--c-text-soft); }
  .fcb-preview .dv__legend span { display:inline-flex; align-items:center; gap:.4rem; } .fcb-preview .dv__legend i { width:.8rem; height:.8rem; border-radius:3px; flex:none; }
  .fcb-preview .dv-set { display:flex; flex-direction:column; gap:1.25rem; margin:1.25rem 0; }
  @media (max-width:560px){ .fcb-preview .dv__rw { grid-template-columns:1fr auto; } .fcb-preview .dv__lab { grid-column:1/-1; } }
  .fcb-quelle { border: 1px solid var(--c-border); border-radius: 9px; padding: .7rem; background: var(--c-surface); display: grid; gap: .4rem; }
  .fcb-quelle .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: .4rem; }
  @media (max-width: 560px) { .fcb-quelle .row2 { grid-template-columns: 1fr; } }
  .fcb-quelle .del { justify-self: start; font: inherit; font-size: .8rem; color: var(--c-falsch); background: none; border: none; cursor: pointer; padding: 0; }
  .fcb-add { font: inherit; font-weight: 700; font-size: .9rem; cursor: pointer; width: 100%; padding: .6rem; border: 1px dashed var(--c-border-strong); border-radius: 8px; background: var(--c-surface); color: var(--c-accent); margin-top: .6rem; }

  .fcb-preview-col { position: sticky; top: 4rem; }
  @media (max-width: 900px) { .fcb-preview-col { position: static; } }
  .fcb-preview {
    background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius);
    box-shadow: var(--shadow); padding: 1.4rem 1.5rem; min-height: 8rem;
  }
  .fcb-preview .platzhalter { color: var(--c-text-soft); font-style: italic; }

  /* seiten-scoped Boxen aus der Faktencheck-Detailseite gespiegelt */
  .fcb-preview .behauptung-box, .fcb-preview .kurzantwort-box {
    margin: 1.1rem 0; padding: 1rem 1.2rem; border-radius: var(--radius); border: 1px solid var(--c-border); border-left-width: 4px;
  }
  .fcb-preview .behauptung-box { background: var(--c-surface-2); border-left-color: var(--c-falsch); }
  .fcb-preview .kurzantwort-box { background: var(--c-accent-soft); border-left-color: var(--c-accent); }
  .fcb-preview .box-label-sm { font-size: .72rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; }
  .fcb-preview .behauptung-box .box-label-sm { color: var(--c-falsch); }
  .fcb-preview .kurzantwort-box .box-label-sm { color: var(--c-accent); }
  .fcb-preview .behauptung-box p { margin: .3rem 0 0; font-style: italic; font-size: 1.1rem; }
  .fcb-preview .kurzantwort-box p { margin: .25rem 0 0; font-size: 1.1rem; line-height: 1.5; }
  .fcb-preview .tag-list { display: flex; flex-wrap: wrap; gap: .4rem; margin: 1rem 0; align-items: center; }

  .fcb-out { margin-top: 1.25rem; background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); padding: 1.1rem 1.2rem; }
  .fcb-actions { display: flex; gap: .6rem; flex-wrap: wrap; }
  .fcb-status { margin: .7rem 0 0; padding: .6rem .85rem; border-radius: 8px; font-size: .9rem; font-weight: 600; }
  .fcb-status.info { background: var(--c-accent-soft); color: var(--c-accent); }
  .fcb-status.ok { background: color-mix(in srgb, var(--c-pruefen) 14%, var(--c-surface)); color: var(--c-pruefen); }
  .fcb-status.err { background: var(--c-falsch-bg); color: var(--c-falsch); }
  .fcb-status a { color: inherit; font-weight: 800; }
  .fcb-raw { margin-top: .8rem; }
  .fcb-raw pre { margin: .5rem 0 0; padding: .8rem; background: var(--c-surface-2); border-radius: 8px; font-family: var(--font-mono); font-size: .78rem; white-space: pre-wrap; max-height: 18rem; overflow: auto; }
  .fcb-hint { font-size: .85rem; margin-top: 1rem; }
</style>

<script define:vars={{ repo }}>
  const $ = (id) => document.getElementById(id);
  const state = {};
  const [UP_OWNER, UP_REPO] = repo.split("/");
  const AUTH_BASE = "https://sveltia-cms-auth.p-seidler.workers.dev";
  const FARBEN = ["accent", "neutral", "falsch", "irrefuehrend", "kontext", "teils", "pruefen"];
  const farbVar = (f) => ({ accent: "var(--c-accent)", falsch: "var(--c-falsch)", irrefuehrend: "var(--c-irrefuehrend)", kontext: "var(--c-kontext)", teils: "var(--c-teils)", pruefen: "var(--c-pruefen)", neutral: "var(--c-border-strong)" }[f] || "var(--c-border-strong)");
  const CHART_TYPEN = [["vergleich", "Vergleich"], ["anteil", "Anteil"], ["zusammensetzung", "Zusammensetzung"], ["kennzahl", "Kennzahl"]];

  // --- mini-Markdown nur für die Vorschau (fett, Absätze, einfache Listen) ---
  function esc(s) { return (s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }
  function inline(s) { return esc(s).replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>"); }
  function mdToHtml(src) {
    if (!src || !src.trim()) return "";
    const blocks = src.replace(/\r/g, "").split(/\n{2,}/);
    return blocks.map((b) => {
      const lines = b.split("\n");
      if (lines.every((l) => /^\s*-\s+/.test(l) || !l.trim())) {
        const items = lines.filter((l) => l.trim()).map((l) => `<li>${inline(l.replace(/^\s*-\s+/, ""))}</li>`).join("");
        return `<ul>${items}</ul>`;
      }
      return `<p>${lines.map(inline).join("<br>")}</p>`;
    }).join("");
  }

  // --- Quellen-Zeilen ---
  const quellenBox = $("f-quellen");
  function addQuelle(vals = {}) {
    const div = document.createElement("div");
    div.className = "fcb-quelle";
    const v = (x) => (x || "").replace(/"/g, "&quot;");
    div.innerHTML = `
      <label class="q-f"><span>Titel der Quelle</span><input type="text" class="q-titel" placeholder="z. B. „Polizeiliche Kriminalstatistik 2024“" value="${v(vals.titel)}" /></label>
      <div class="row2">
        <label class="q-f"><span>Herausgeber</span><input type="text" class="q-hg" placeholder="Destatis, BKA, UBA …" value="${v(vals.herausgeber)}" /></label>
        <label class="q-f"><span>Jahr/Datum (optional)</span><input type="text" class="q-datum" placeholder="2024" value="${v(vals.datum)}" /></label>
      </div>
      <label class="q-f"><span>Link (optional)</span><input type="url" class="q-url" placeholder="https://…" value="${v(vals.url)}" /></label>
      <div class="row2 q-bottom">
        <label class="q-f"><span>Art</span><select class="q-art"><option value="primaer">Primärquelle (amtlich/original)</option><option value="sekundaer">Sekundärquelle</option></select></label>
        <button type="button" class="del">Quelle entfernen</button>
      </div>`;
    div.querySelector(".q-art").value = vals.art || "primaer";
    div.querySelector(".del").addEventListener("click", () => { div.remove(); render(); });
    div.querySelectorAll("input,select").forEach((el) => el.addEventListener("input", render));
    quellenBox.appendChild(div);
  }
  $("f-quelle-add").addEventListener("click", () => { addQuelle(); render(); });

  function getQuellen() {
    return [...quellenBox.querySelectorAll(".fcb-quelle")].map((d) => ({
      titel: d.querySelector(".q-titel").value.trim(),
      herausgeber: d.querySelector(".q-hg").value.trim(),
      datum: d.querySelector(".q-datum").value.trim(),
      url: d.querySelector(".q-url").value.trim(),
      art: d.querySelector(".q-art").value,
    })).filter((q) => q.titel || q.herausgeber);
  }

  // ---------- Datengrafik-Builder ----------
  const chartsBox = $("f-charts");
  function addWert(box, vals = {}) {
    const row = document.createElement("div");
    row.className = "c-wert";
    row.innerHTML = `
      <input type="text" class="w-label" placeholder="Label" value="${(vals.label||"").replace(/"/g,"&quot;")}" />
      <input type="number" class="w-wert" step="any" placeholder="Zahl" value="${vals.wert ?? ""}" />
      <input type="text" class="w-einheit" placeholder="%" value="${(vals.einheit||"").replace(/"/g,"&quot;")}" />
      <select class="w-farbe">${FARBEN.map((f) => `<option ${vals.farbe===f?"selected":""}>${f}</option>`).join("")}</select>
      <button type="button" class="c-del" title="Wert entfernen">✕</button>`;
    if (vals.farbe) row.querySelector(".w-farbe").value = vals.farbe;
    row.querySelector(".c-del").addEventListener("click", () => { row.remove(); render(); });
    row.querySelectorAll("input,select").forEach((el) => el.addEventListener("input", render));
    box.appendChild(row);
  }
  function addChart(vals = {}) {
    const card = document.createElement("div");
    card.className = "fcb-chart";
    card.innerHTML = `
      <div class="c-row">
        <label class="q-f"><span>Typ</span><select class="c-typ">${CHART_TYPEN.map(([v,l]) => `<option value="${v}" ${vals.typ===v?"selected":""}>${l}</option>`).join("")}</select></label>
        <label class="q-f"><span>Quelle</span><input type="text" class="c-quelle" placeholder="z. B. Bundesnetzagentur" value="${(vals.quelle||"").replace(/"/g,"&quot;")}" /></label>
      </div>
      <label class="q-f"><span>Titel der Grafik (optional, <strong>…</strong> erlaubt)</span><input type="text" class="c-titel" value="${(vals.titel||"").replace(/"/g,"&quot;")}" /></label>
      <label class="c-check"><input type="checkbox" class="c-primaer" ${vals.primaer?"checked":""} /> Primärquelle (amtlich)</label>
      <div class="c-werte"></div>
      <button type="button" class="c-werte-add">+ Wert</button>
      <button type="button" class="del">Grafik entfernen</button>`;
    if (vals.typ) card.querySelector(".c-typ").value = vals.typ;
    const wbox = card.querySelector(".c-werte");
    const init = vals.werte && vals.werte.length ? vals.werte : [{ farbe: "accent" }, { farbe: "neutral" }];
    init.forEach((w) => addWert(wbox, w));
    card.querySelector(".c-werte-add").addEventListener("click", () => { addWert(wbox); render(); });
    card.querySelector(".del").addEventListener("click", () => { card.remove(); render(); });
    card.querySelectorAll(".c-typ,.c-titel,.c-quelle,.c-primaer").forEach((el) => el.addEventListener("input", render));
    chartsBox.appendChild(card);
  }
  $("f-chart-add").addEventListener("click", () => { addChart(); render(); });

  function getCharts() {
    return [...chartsBox.querySelectorAll(".fcb-chart")].map((c) => ({
      typ: c.querySelector(".c-typ").value,
      titel: c.querySelector(".c-titel").value.trim(),
      quelle: c.querySelector(".c-quelle").value.trim(),
      primaer: c.querySelector(".c-primaer").checked,
      werte: [...c.querySelectorAll(".c-wert")].map((r) => ({
        label: r.querySelector(".w-label").value.trim(),
        wert: r.querySelector(".w-wert").value.trim(),
        einheit: r.querySelector(".w-einheit").value.trim(),
        farbe: r.querySelector(".w-farbe").value,
      })).filter((w) => w.label || w.wert !== ""),
    })).filter((c) => c.werte.length);
  }
  function chartHTML(c) {
    const rich = (s) => esc(s).replace(/&lt;(\/?(?:strong|em))&gt;/g, "<$1>");
    const allePct = c.werte.every((w) => (w.einheit || "%") === "%");
    const max = allePct ? 100 : Math.max(...c.werte.map((w) => +w.wert || 0), 0.0001);
    let inner = "";
    if (c.typ === "kennzahl") {
      inner = `<div class="dv__stats">${c.werte.map((w) => `<div class="dv__stat" style="border-left-color:${farbVar(w.farbe)}"><div class="dv__num" style="color:${farbVar(w.farbe)}">${esc(w.wert)}${esc(w.einheit||"")}</div>${w.label?`<div class="dv__cap">${esc(w.label)}</div>`:""}</div>`).join("")}</div>`;
    } else if (c.typ === "zusammensetzung") {
      inner = `<div class="dv__stack">${c.werte.map((w) => `<div class="dv__seg" style="width:${+w.wert||0}%;background:${farbVar(w.farbe)}"><span>${esc(w.label)} ${esc(w.wert)}${esc(w.einheit||"%")}</span></div>`).join("")}</div><div class="dv__legend">${c.werte.map((w) => `<span><i style="background:${farbVar(w.farbe)}"></i>${esc(w.label)}</span>`).join("")}</div>`;
    } else {
      inner = `<div class="dv__bars">${c.werte.map((w) => `<div class="dv__rw"><div class="dv__lab">${esc(w.label)}</div><div class="dv__track"><div class="dv__fill" style="width:${Math.max(1,((+w.wert||0)/max)*100)}%;background:${farbVar(w.farbe)}"></div></div><div class="dv__val">${esc(w.wert)}${esc(w.einheit||"%")}</div></div>`).join("")}</div>`;
    }
    return `<figure class="dv">${c.titel?`<figcaption class="dv__title">${rich(c.titel)}</figcaption>`:""}${inner}${c.quelle?`<div class="dv__source">${esc(c.quelle)}${c.primaer?`<span class="q-tag">Primärquelle</span>`:""}</div>`:""}</figure>`;
  }

  function checked(name) { return [...document.querySelectorAll(`input[name="${name}"]:checked`)].map((c) => c.value); }
  function labelFor(name, val) {
    const el = document.querySelector(`input[name="${name}"][value="${val}"]`);
    return el ? el.parentElement.textContent.trim() : val;
  }

  function slugify(s) {
    return (s || "faktencheck").toLowerCase()
      .replace(/[äÄ]/g, "ae").replace(/[öÖ]/g, "oe").replace(/[üÜ]/g, "ue").replace(/ß/g, "ss")
      .replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 60) || "faktencheck";
  }

  // ---------- VORSCHAU ----------
  function render() {
    const v = {
      behauptung: $("f-behauptung").value.trim(),
      titel: $("f-titel").value.trim(),
      urteil: $("f-urteil").value,
      kurzantwort: $("f-kurzantwort").value.trim(),
      zus: $("f-zus").value.trim(),
      einleitung: $("f-einleitung").value.trim(),
      einstieg: $("f-einstieg").value.trim(),
      vertiefung: $("f-vertiefung").value.trim(),
      wiss: $("f-wiss").value.trim(),
      tTitel: $("f-technik-titel").value.trim(),
      tText: $("f-technik-text").value.trim(),
      pruefen: $("f-pruefen").value.trim(),
    };
    const themen = checked("thema");
    const techniken = checked("technik");
    const quellen = getQuellen();
    const urteilLabel = document.querySelector(`#f-urteil option[value="${v.urteil}"]`).textContent;

    // --- Vorschau-HTML (nutzt echte globale Klassen) ---
    let html = "";
    const hasAny = v.behauptung || v.titel || v.kurzantwort || v.einstieg;
    if (!hasAny) {
      html = `<p class="platzhalter">Hier erscheint live, wie dein Faktencheck aussehen wird. Fang links mit der Behauptung an.</p>`;
    } else {
      html += `<div class="card__meta" style="display:flex;gap:.45rem;flex-wrap:wrap;align-items:center;margin-bottom:.6rem;">`;
      html += `<span class="badge urteil urteil--${v.urteil}">${esc(urteilLabel)}</span>`;
      themen.forEach((t) => { html += `<span class="badge">${esc(labelFor("thema", t))}</span>`; });
      html += `</div>`;
      if (v.titel) html += `<h1 style="margin:.4rem 0 0;">${esc(v.titel)}</h1>`;
      if (v.behauptung) html += `<div class="behauptung-box"><span class="box-label-sm">Die Behauptung</span><p>„${esc(v.behauptung)}“</p></div>`;
      if (v.kurzantwort) html += `<div class="kurzantwort-box"><span class="box-label-sm">Kurzantwort</span><p>${esc(v.kurzantwort)}</p></div>`;
      if (techniken.length) {
        html += `<div class="tag-list"><span class="muted" style="font-size:.85rem;">Erkannte Maschen:</span>`;
        techniken.forEach((t) => { html += `<span class="badge badge--technik">${esc(labelFor("technik", t))} →</span>`; });
        html += `</div>`;
      }
      if (v.einleitung) html += `<div class="prose">${mdToHtml(v.einleitung)}</div>`;
      const stufen = [["Einstieg", v.einstieg], ["Vertiefung", v.vertiefung], ["Wissenschaftlich", v.wiss]];
      html += `<div class="prose">`;
      stufen.forEach(([label, txt]) => { if (txt) html += `<p class="stufe-heading">${label}</p>${mdToHtml(txt)}`; });
      if (v.tTitel || v.tText) html += `<aside class="box box-technik"><p class="box-label"><strong>Technik erkannt: ${esc(v.tTitel)}</strong></p>${mdToHtml(v.tText)}</aside>`;
      if (v.pruefen) html += `<aside class="box box-pruefen"><p class="box-label"><strong>So prüfst du das selbst</strong></p>${mdToHtml(v.pruefen)}</aside>`;
      html += `</div>`;
      const charts = getCharts();
      if (charts.length) {
        html += `<section style="margin-top:1.5rem;"><h2 style="margin:0 0 .5rem;">Die Zahlen im Überblick</h2><div class="dv-set">${charts.map(chartHTML).join("")}</div></section>`;
      }
      if (quellen.length) {
        html += `<section class="quellen"><h2>Quellen</h2><ol>`;
        quellen.forEach((q) => {
          html += `<li class="${q.art === "primaer" ? "q-primaer" : ""}">${q.url ? `<a href="${esc(q.url)}">${esc(q.titel)}</a>` : esc(q.titel)}${q.art === "primaer" ? ` <span class="q-tag">Primärquelle</span>` : ""}<br><span class="muted">${esc(q.herausgeber)}${q.datum ? " · " + esc(q.datum) : ""}</span></li>`;
        });
        html += `</ol></section>`;
      }
    }
    $("fcb-preview").innerHTML = html;

    // --- Frontmatter erzeugen ---
    const today = new Date().toISOString().slice(0, 10);
    const qs = (s) => `"${(s || "").replace(/"/g, "”").replace(/\n/g, " ")}"`;
    const block = (s) => s ? `|\n${s.replace(/\r/g, "").split("\n").map((l) => "  " + l).join("\n")}` : `""`;
    const arr = (a) => "[" + a.map((x) => `"${x}"`).join(", ") + "]";
    let fm = "---\n";
    fm += `titel: ${qs(v.titel)}\n`;
    fm += `behauptung: ${qs(v.behauptung)}\n`;
    fm += `kurzantwort: ${qs(v.kurzantwort)}\n`;
    fm += `urteil: "${v.urteil}"\n`;
    fm += `themen: ${arr(themen.length ? themen : ["migration"])}\n`;
    fm += `techniken: ${arr(techniken)}\n`;
    fm += `zusammenfassung: ${qs(v.zus || v.kurzantwort)}\n`;
    fm += `status: "entwurf"\n`;
    fm += `veroeffentlicht: ${today}\n`;
    fm += `mitwirkende: []\n`;
    fm += `quellen:\n`;
    if (quellen.length) {
      quellen.forEach((q) => {
        fm += `  - titel: ${qs(q.titel)}\n    herausgeber: ${qs(q.herausgeber)}\n`;
        if (q.url) fm += `    url: ${qs(q.url)}\n`;
        if (q.datum) fm += `    datum: ${qs(q.datum)}\n`;
        fm += `    art: "${q.art}"\n`;
      });
    } else {
      fm += `  - titel: "QUELLE EINTRAGEN"\n    herausgeber: ""\n    art: "primaer"\n`;
    }
    fm += `verwandt: []\n`;
    fm += `einleitung: ${block(v.einleitung)}\n`;
    fm += `einstieg: ${block(v.einstieg)}\n`;
    fm += `vertiefung: ${block(v.vertiefung)}\n`;
    fm += `wissenschaftlich: ${block(v.wiss)}\n`;
    fm += `technik_titel: ${qs(v.tTitel)}\n`;
    fm += `technik_text: ${block(v.tText)}\n`;
    fm += `pruefen: ${block(v.pruefen)}\n`;
    const charts = getCharts();
    if (charts.length) {
      fm += `daten:\n`;
      charts.forEach((c) => {
        fm += `  - typ: ${c.typ}\n`;
        if (c.titel) fm += `    titel: ${qs(c.titel)}\n`;
        if (c.quelle) fm += `    quelle: ${qs(c.quelle)}\n`;
        if (c.primaer) fm += `    primaer: true\n`;
        fm += `    werte:\n`;
        c.werte.forEach((w) => {
          fm += `      - label: ${qs(w.label)}\n        wert: ${w.wert === "" ? 0 : w.wert}\n`;
          if ((w.einheit || "%") !== "%") fm += `        einheit: ${qs(w.einheit)}\n`;
          fm += `        farbe: ${w.farbe}\n`;
        });
      });
    }
    fm += "---\n";

    $("f-raw").textContent = fm;

    // --- GitHub „neue Datei"-Link (Fallback: Editor vorausgefüllt → PR) ---
    const slug = slugify(v.titel || v.behauptung);
    const url = `https://github.com/${repo}/new/main?filename=src/content/faktenchecks/${slug}.md&value=${encodeURIComponent(fm)}`;
    $("f-github").setAttribute("href", url);

    // Stand für „Absenden" merken
    state.fm = fm; state.slug = slug; state.titel = v.titel || "Neuer Faktencheck";
    state.behauptung = v.behauptung; state.kurzantwort = v.kurzantwort; state.quellenN = quellen.length;
    state.fallbackUrl = url;
  }

  $("f-copy").addEventListener("click", async () => {
    try { await navigator.clipboard.writeText($("f-raw").textContent); const b = $("f-copy"); const t = b.textContent; b.textContent = "Kopiert ✓"; setTimeout(() => (b.textContent = t), 1600); } catch {}
  });

  // ---------- ABSENDEN: OAuth-Login + GitHub-API (PR im Hintergrund) ----------
  function status(msg, kind) {
    const el = $("f-status");
    el.className = "fcb-status " + (kind || "info");
    el.innerHTML = msg;
    el.hidden = false;
  }

  // OAuth-Popup nach dem Netlify/Sveltia-Protokoll (Handshake → Token).
  function login() {
    return new Promise((resolve, reject) => {
      const w = 640, h = 720, left = (screen.width - w) / 2, top = (screen.height - h) / 2;
      const popup = window.open(
        `${AUTH_BASE}/auth?provider=github&scope=public_repo&site_id=${encodeURIComponent(location.hostname)}`,
        "kompetenz-oauth", `width=${w},height=${h},left=${left},top=${top}`,
      );
      if (!popup) { reject(new Error("Popup blockiert – bitte erlauben")); return; }
      let done = false;
      function onMsg(e) {
        if (typeof e.data !== "string") return;
        if (e.data === "authorizing:github") { popup.postMessage("authorizing:github", "*"); return; }
        const m = e.data.match(/^authorization:github:(success|error):(.*)$/);
        if (!m) return;
        done = true; window.removeEventListener("message", onMsg);
        try { popup.close(); } catch {}
        if (m[1] === "success") { try { resolve(JSON.parse(m[2]).token); } catch { reject(new Error("Token unlesbar")); } }
        else reject(new Error("Login fehlgeschlagen"));
      }
      window.addEventListener("message", onMsg);
      const iv = setInterval(() => { if (popup.closed && !done) { clearInterval(iv); window.removeEventListener("message", onMsg); reject(new Error("Login-Fenster geschlossen")); } }, 700);
    });
  }

  async function gh(token, path, opts = {}) {
    const r = await fetch("https://api.github.com" + path, {
      ...opts,
      headers: { Authorization: "token " + token, Accept: "application/vnd.github+json", "Content-Type": "application/json", ...(opts.headers || {}) },
    });
    if (!r.ok) throw new Error("GitHub " + r.status + ": " + (await r.text()).slice(0, 120));
    return r.status === 204 ? {} : r.json();
  }
  const b64 = (s) => btoa(unescape(encodeURIComponent(s)));
  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

  async function einreichen() {
    const fehlt = [];
    if (!state.titel || state.titel === "Neuer Faktencheck") fehlt.push("Titel");
    if (!state.behauptung) fehlt.push("Behauptung");
    if (!state.kurzantwort) fehlt.push("Kurzantwort");
    if (!state.quellenN) fehlt.push("mindestens eine Quelle");
    if (fehlt.length) { status("Bitte noch ausfüllen: " + fehlt.join(", ") + ".", "err"); return; }

    const btn = $("f-submit");
    btn.disabled = true;
    try {
      status("Anmelden … bitte im Fenster bestätigen.", "info");
      const token = await login();
      status("Faktencheck wird eingereicht …", "info");

      const me = await gh(token, "/user");
      const branch = `faktencheck-${state.slug}-${Date.now().toString(36)}`;

      let canPush = false;
      try {
        const p = await gh(token, `/repos/${UP_OWNER}/${UP_REPO}/collaborators/${me.login}/permission`);
        canPush = ["admin", "write", "maintain"].includes(p.permission);
      } catch { canPush = false; }

      let owner, repoName, prHead;
      if (canPush) {
        owner = UP_OWNER; repoName = UP_REPO; prHead = branch;
      } else {
        const fork = await gh(token, `/repos/${UP_OWNER}/${UP_REPO}/forks`, { method: "POST" });
        owner = me.login; repoName = fork.name; prHead = `${me.login}:${branch}`;
        for (let i = 0; i < 12; i++) { try { await gh(token, `/repos/${owner}/${repoName}/git/ref/heads/main`); break; } catch { await sleep(1500); } }
      }

      const baseRef = await gh(token, `/repos/${owner}/${repoName}/git/ref/heads/main`);
      await gh(token, `/repos/${owner}/${repoName}/git/refs`, { method: "POST", body: JSON.stringify({ ref: `refs/heads/${branch}`, sha: baseRef.object.sha }) });
      await gh(token, `/repos/${owner}/${repoName}/contents/src/content/faktenchecks/${state.slug}.md`, {
        method: "PUT",
        body: JSON.stringify({ message: `Neuer Faktencheck: ${state.titel}`, content: b64(state.fm), branch }),
      });
      const pr = await gh(token, `/repos/${UP_OWNER}/${UP_REPO}/pulls`, {
        method: "POST",
        body: JSON.stringify({ title: `Neuer Faktencheck: ${state.titel}`, head: prHead, base: "main", body: "Eingereicht über den Faktencheck-Baukasten. Bitte gegenlesen; Status auf „geprueft“ setzen, sobald die Quellen abgenommen sind." }),
      });

      status(`✓ Eingereicht – danke! Dein Vorschlag liegt als <a href="${pr.html_url}" target="_blank" rel="noopener">Pull Request #${pr.number}</a> bereit. Die Redaktion liest gegen und gibt ihn frei.`, "ok");
      btn.textContent = "Eingereicht ✓";
    } catch (err) {
      $("f-fallback-wrap").hidden = false;
      status("Automatisches Absenden hat nicht geklappt (" + (err && err.message ? err.message : err) + "). Kein Problem: nimm den Link „Manuell über GitHub anlegen“ unten oder „Nur Text kopieren“.", "err");
      btn.disabled = false;
    }
  }
  $("f-submit").addEventListener("click", einreichen);

  // ⓘ neben einer Masche: Erklärung ein-/ausklappen
  document.querySelectorAll("[data-info]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const desc = btn.parentElement.querySelector(".fcb-masche-desc");
      const oeffnen = desc.hidden;
      desc.hidden = !oeffnen;
      btn.setAttribute("aria-expanded", String(oeffnen));
    });
  });

  // „Aus markierten Maschen übernehmen“ -> Trick-Box-Überschrift vorbefüllen
  $("f-technik-auto").addEventListener("click", () => {
    const namen = [...document.querySelectorAll('input[name="technik"]:checked')]
      .map((c) => c.parentElement.querySelector(".fcb-masche-name").textContent.trim());
    if (namen.length) { $("f-technik-titel").value = namen.join(" & "); render(); }
  });

  document.getElementById("fcb-form").addEventListener("input", render);
  addQuelle(); // eine leere Quelle vorbereiten
  render();
</script>
