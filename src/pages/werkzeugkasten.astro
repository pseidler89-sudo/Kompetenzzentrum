---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pfad } from "../lib/labels";

const sift = [
  { kurz: "Innehalten", original: "Stop", text: "Bevor du teilst oder dich aufregst: kurz innehalten. Kennst du die Quelle? Löst die Meldung starke Emotionen aus? Genau dann ist Vorsicht geboten." },
  { kurz: "Quelle hinterfragen", original: "Investigate the source", text: "Wer steht hinter der Quelle? Suche den Namen des Mediums/Autors getrennt – nicht auf der Seite selbst, sondern „seitwärts“ (Wikipedia, andere Medien)." },
  { kurz: "Bessere Belege suchen", original: "Find better coverage", text: "Berichten seriöse, unabhängige Quellen dasselbe? Gibt es nur eine einzige Quelle, ist Skepsis angebracht." },
  { kurz: "Behauptung zurückverfolgen", original: "Trace claims", text: "Verfolge Zitate, Zahlen und Bilder zurück zum Ursprung. Oft ist der Kontext entscheidend – oder die Originalquelle sagt etwas ganz anderes." },
];
---

<BaseLayout titel="Werkzeugkasten" beschreibung="Methoden, um Informationen selbst zu finden und zu bewerten.">
  <h1>Werkzeugkasten</h1>
  <p class="lead">
    Hier geht es ums <strong>Selbst-Prüfen</strong>: wie du Informationen findest,
    einordnest und bewertest. (Die Manipulations-<em>Maschen</em>, mit denen du
    getäuscht werden sollst, findest du auf der eigenen <a href={pfad("/maschen")}>Maschen-Seite</a>.)
  </p>

  <section>
    <h2>Die 4-Schritte-Methode zum Einordnen</h2>
    <p>
      Profis prüfen nicht, indem sie eine Seite gründlich lesen, sondern indem sie
      <strong>seitwärts lesen</strong>: Sie verlassen die Seite und schauen, was
      andere über sie sagen. Diese vier Schritte fassen das zusammen
      (international bekannt als <abbr title="Stop, Investigate, Find, Trace">SIFT</abbr>-Methode).
    </p>
    <div class="grid grid--2">
      {sift.map((s, i) => (
        <div class="card">
          <div class="card__meta"><span class="badge">Schritt {i + 1}</span></div>
          <h3 style="margin:0;">{s.kurz}</h3>
          <p style="margin:0;">{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2>Schnell-Checkliste für jede Behauptung</h2>
    <ul class="checkliste">
      <li><strong>Quelle:</strong> Wer sagt das – und welches Interesse könnte dahinterstecken?</li>
      <li><strong>Beleg:</strong> Wird eine überprüfbare Quelle genannt? Führt der Link wirklich dorthin?</li>
      <li><strong>Bezugsgröße:</strong> Steht eine Zahl im Verhältnis (pro Kopf, im Zeitverlauf, im Vergleich)?</li>
      <li><strong>Aktualität:</strong> Wie alt ist die Information? Gilt sie noch?</li>
      <li><strong>Konsens:</strong> Was sagt die Mehrheit der Fachleute – nicht eine laute Einzelstimme?</li>
      <li><strong>Emotion:</strong> Soll hier informiert oder vor allem Wut/Angst erzeugt werden?</li>
    </ul>
  </section>

  <section>
    <h2>Praktische Recherche-Werkzeuge</h2>
    <ul class="werkzeuge">
      <li><strong>Rückwärts-Bildersuche</strong> (Google Lens, TinEye): Stammt ein Foto wirklich aus dem behaupteten Kontext?</li>
      <li><strong>Amtliche Statistik:</strong> <a href="https://www.destatis.de" rel="noopener">Destatis</a>, <a href="https://www.bundesbank.de" rel="noopener">Bundesbank</a>, <a href="https://www.bka.de" rel="noopener">BKA (PKS)</a> – Zahlen aus erster Hand.</li>
      <li><strong>Wissenschaft:</strong> <a href="https://scholar.google.com" rel="noopener">Google Scholar</a>, <a href="https://www.science-media-center.de" rel="noopener">Science Media Center</a> für eingeordnete Forschung.</li>
      <li><strong>Etablierte Faktenchecks:</strong> <a href="https://correctiv.org/faktencheck/" rel="noopener">CORRECTIV</a>, <a href="https://www.tagesschau.de/faktenfinder" rel="noopener">ARD-Faktenfinder</a>, <a href="https://euvsdisinfo.eu" rel="noopener">EUvsDisinfo</a>.</li>
    </ul>
  </section>

  <section id="techniken" class="masche-verweis">
    <h2>Und die Gegenseite: Manipulation erkennen</h2>
    <p>
      Selbst prüfen ist die eine Hälfte. Die andere: die <strong>Maschen</strong> kennen,
      mit denen man dich täuschen will. Jede ist einzeln erklärt – wie sie funktioniert,
      ein aktuelles Beispiel und wie du sie durchschaust.
    </p>
    <a class="btn btn--primary" href={pfad("/maschen")}>Zu den Maschen</a>
    <a class="btn btn--ghost" href={pfad("/quiz")} style="margin-left:.6rem;">Im Quiz üben</a>
  </section>
</BaseLayout>

<style>
  section { margin-top: 3rem; }
  .checkliste, .werkzeuge { display: grid; gap: .6rem; padding-left: 1.2rem; }
  .masche-verweis {
    padding: 1.75rem; border-radius: var(--radius);
    background: color-mix(in srgb, var(--c-technik) 7%, var(--c-surface));
    border: 1px solid color-mix(in srgb, var(--c-technik) 25%, transparent);
  }
  .masche-verweis h2 { margin-top: 0; }
</style>
